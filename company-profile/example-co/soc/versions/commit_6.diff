+{"schemaVersion":"1","kind":"finding","id":"fnd_01M2G2AGTH64FMR4XR77ZAJH7B","companyId":"example-co","title":"CreateDBUserTool returns a newly generated password in plain text","description":"src/tools/atlas/create/createDBUser.ts:84-96: when the tool auto-generates a password, the success content text is `User \"${username}\" created successfully with password: \\`${password}\\`.`, sent as the raw JSON-RPC tool result. `this.session.keychain.register(password, \"password\")` runs immediately before, but keychain-based redaction (loggerBase.ts) only scrubs subsequent logger output, not the direct tool-result payload that reaches the MCP client transcript. Commit aaa72a040db4c32f3d6488d5e28e2892a68e9ee0.","severity":"high","confidence":"confirmed","controlIds":["sebi-cscrf-2024:PR.AA.S1"],"regulatoryRefs":[{"regulator":"SEBI","instrument":"sebi-cscrf-2024","controlId":"PR.AA.S1"},{"regulator":"NIST","instrument":"nist-csf-2.0","controlId":"PR.AA-01"},{"regulator":"ISO","instrument":"iso-27001-2022","controlId":"A.5.16"},{"regulator":"NIST","instrument":"nist-800-53-r5","controlId":"AC-2"}],"target":{"type":"repo","appId":"mcp-gateway","repoId":"mongodb-mcp-server"},"location":{"path":"src/tools/atlas/create/createDBUser.ts","startLine":84,"endLine":96},"fingerprint":"58e52ab00629802d32f2bd8b1d2175da111ce75012cbe4a5c38917ef147635b0","source":{"kind":"sarif","ruleId":"SCH-API-06","tool":"maxwell-schema-auditor","toolVersion":"1.0.0"},"status":"open","firstSeenAt":"2026-09-14T13:14:50Z","lastSeenAt":"2026-09-14T13:14:50Z","slaDueAt":"2026-09-21T13:14:50Z","slaBasis":{"instrument":"sebi-cscrf-2024","controlId":"PR.MA.S3","topic":"patch-sla","severity":"high","days":7},"relatedObservationIds":["obs_01M2G2AGGSXWPRR33K23JB6E90"],"evidence":[{"type":"sarif","ref":"kpis/data/raw/sessions/314aa113-98aa-471e-941d-e1aa88798b5a/probe-schemas.mcp-gateway.mongodb-mcp-server.sarif.export.json","sha256":"083528627e5887bdeea0827ad8655e5a65240c94c36785ff58a893c3b00b3170","description"