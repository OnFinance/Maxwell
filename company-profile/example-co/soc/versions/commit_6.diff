+{"schemaVersion":"1","kind":"observation","id":"obs_01M2G2AGMDK4QXKHJRCYDQKTZT","companyId":"example-co","controlIds":["sebi-cscrf-2024:PR.AA.S17"],"title":"Tool-argument schemas place no bounds on the query surface reaching MongoDB","description":"src/tools/args.ts's zEJSON() (lines 78-90, used for find/export filters and every non-vector-search aggregation stage) is `z.object({}).loose()` with no maxItems on the enclosing pipeline array and no maxLength/pattern on keys or values; DBOperationArgs.database and CollOperationArgs.collection (mongodbTool.ts:11-17) are plain z.string() with no length cap or character allow-list, unlike CommonArgs.string()'s NO_UNICODE_REGEX in the same repo (args.ts:22-23). This is an input-validation gap on the tool-call surface, not a rate-limiting mechanism, which this codebase does not implement at all for MCP tool calls.","methods":["probe-schemas"],"subjects":[{"type":"repo","appId":"mcp-gateway","repoId":"mongodb-mcp-server"}],"collectedAt":"2026-09-14T13:14:50Z","expiresAt":"2026-10-14T13:14:50Z","result":"not-satisfied","toolOutput":{"format":"sarif","path":"kpis/data/raw/sessions/314aa113-98aa-471e-941d-e1aa88798b5a/probe-schemas.mcp-gateway.mongodb-mcp-server.sarif.export.json","sha256":"083528627e5887bdeea0827ad8655e5a65240c94c36785ff58a893c3b00b3170"},"evidence":[{"type":"workspace-file","ref":"applications/mcp-gateway/repos/mongodb-mcp-server/src/tools/args.ts","description":"zEJSON() open schema, lines 78-90"},{"type":"sarif","ref":"kpis/data/raw/sessions/314aa113-98aa-471e-941d-e1aa88798b5a/probe-schemas.mcp-gateway.mongodb-mcp-server.sarif.export.json","sha256":"083528627e5887bdeea0827ad8655e5a65240c94c36785ff58a893c3b00b3170","description":"SCH-API-02 result"}],"tags":["schema","data-protection","static-probe"],"provenance":{"harness":"claude-code","generatedAt":"2026-09-14T13:14:50Z","sessionId":"314aa113-98aa-471e-941d-e1aa88798b5a","runId":"run_01M2FGNVVQ15ZKXZWGW74YWAAQ","workflow":"probe-schemas","agent":"soc-led