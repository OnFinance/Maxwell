+{"schemaVersion":"1","kind":"finding","id":"fnd_01M2G2AGSC977KASP37WQXYSQA","companyId":"example-co","title":"export tool writes full unmasked documents to an unencrypted local file","description":"src/tools/mongodb/read/export.ts:68-98: ExportTool.execute streams the full find/aggregate cursor to a local JSON file via ExportsManager.createJSONExport with no field mask and no encryption-at-rest on the export file; the file is exposed to the caller via a resource URI and, on stdio transport (isServerRunningLocally(), lines 131-133), its plain filesystem path. Cleanup relies on ExportsManager.close() deleting the session export directory and a best-effort TTL sweep (config.exportTimeoutMs, default 300000ms), not immediate purge. Commit aaa72a040db4c32f3d6488d5e28e2892a68e9ee0.","severity":"high","confidence":"confirmed","controlIds":["sebi-cscrf-2024:PR.DS.S4","dpdp-rules-2025:6(1)(a)"],"regulatoryRefs":[{"regulator":"SEBI","instrument":"sebi-cscrf-2024","controlId":"PR.DS.S4"},{"regulator":"MeitY","instrument":"dpdp-rules-2025","controlId":"6(1)(a)"},{"regulator":"ISO","instrument":"iso-27001-2022","controlId":"A.8.11"}],"target":{"type":"repo","appId":"mcp-gateway","repoId":"mongodb-mcp-server"},"location":{"path":"src/tools/mongodb/read/export.ts","startLine":68,"endLine":98},"fingerprint":"1811d886eea579d34edf505245b99d9a36565fd9a779aee39f217d4764a292a5","source":{"kind":"sarif","ruleId":"SCH-API-03","tool":"maxwell-schema-auditor","toolVersion":"1.0.0"},"status":"open","firstSeenAt":"2026-09-14T13:14:50Z","lastSeenAt":"2026-09-14T13:14:50Z","slaDueAt":"2026-09-21T13:14:50Z","slaBasis":{"instrument":"sebi-cscrf-2024","controlId":"PR.MA.S3","topic":"patch-sla","severity":"high","days":7},"relatedObservationIds":["obs_01M2G2AGE8XFQ4B12MRJBDWYCA","obs_01M2G2AGFHXSCH94CR7SMFERAW"],"evidence":[{"type":"sarif","ref":"kpis/data/raw/sessions/314aa113-98aa-471e-941d-e1aa88798b5a/probe-schemas.mcp-gateway.mongodb-mcp-server.sarif.export.json","sha256":"083528627e5887bdeea0