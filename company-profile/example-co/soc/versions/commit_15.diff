+{"schemaVersion":"1","kind":"observation","id":"obs_01M2HRG71Z57HBWAGD7C9Z5NYJ","recordedAt":"2026-09-15T02:47:35Z","companyId":"example-co","controlIds":["sebi-cscrf-2024:PR.AA.S6"],"title":"Credentials traverse the tool surface in plaintext while config-supplied secrets are redacted","description":"At commit aaa72a040db4c32f3d6488d5e28e2892a68e9ee0 the connect, switch-connection and atlas-create-db-user tools accept live credentials (connection strings with embedded username/password, DB-user passwords) as plain z.string() tool arguments, and atlas-create-db-user echoes a generated password back in the tool response (src/tools/atlas/create/createDBUser.ts:93). Compensating controls exist: every config-supplied secret is registered in the root keychain for redaction (src/common/config/parseUserConfig.ts:157-180), disk logs and telemetry redact keychain secrets by default, and tool error responses are redacted against keychain.allSecrets (src/tools/tool.ts:818-829). See findings SCH-API-06.","methods":["probe-schemas"],"subjects":[{"type":"repo","appId":"mcp-gateway","repoId":"mongodb-mcp-server"}],"collectedAt":"2026-09-15T02:47:35Z","expiresAt":"2027-09-15T02:47:35Z","result":"partial","toolOutput":{"format":"sarif","path":"kpis/data/raw/sessions/opencode/run_01M2GDZ3Q3S5WYCB3MV02QJXZ1.probe-schemas.mcp-gateway.mongodb-mcp-server.sarif.export.json","sha256":"8eb156acade64a5455e26dd6be4125d22283d4c7c53ea66576ccdc9864dcadb3"},"evidence":[{"type":"sarif","ref":"kpis/data/raw/sessions/opencode/run_01M2GDZ3Q3S5WYCB3MV02QJXZ1.probe-schemas.mcp-gateway.mongodb-mcp-server.sarif.export.json","description":"SCH-API-06 results and mcp-config-secrets-registered-for-redaction / mcp-secrets-redacted-in-error-responses pass results","sha256":"8eb156acade64a5455e26dd6be4125d22283d4c7c53ea66576ccdc9864dcadb3"}],"tags":["schema","data-protection","static-probe"],"provenance":{"harness":"opencode","generatedAt":"2026-09-15T02:47:35Z","sessionId":"453ecc6e-1346-418f-a2c0-1bfcead851c