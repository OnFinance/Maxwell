+{"schemaVersion":"1","kind":"observation","id":"obs_01M2FTN49XKFG0B4JAZRP4P6X1","recordedAt":"2026-09-14T11:10:53Z","companyId":"example-co","controlIds":["sebi-cscrf-2024:ID.AM.S5"],"title":"schema-gap: db-models-mongodb in onfinance-db-model-master","description":"The metastore.schema.json catalog.type enum has no document-store value (mongodb), so db-models-mongodb was recorded as catalog type 'other' with table format 'native'. The column model is flat, so embedded documents (EmbeddedDocumentListField) are shown as dotted column names such as user_portfolio_holdings.purchase_price. dataType holds the mongoengine field class as declared. Proposed follow-up: add a document-store catalog type, or a nested-field convention, to the metastore schema (a schema change requires MAXWELL_SCHEMA_EDIT=1 and is out of scope for this workflow).","methods":["refresh-metastore"],"subjects":[{"type":"repo","appId":"db-models","repoId":"onfinance-db-model-master"}],"collectedAt":"2026-09-14T11:10:49Z","result":"partial","evidence":[{"type":"workspace-file","ref":"applications/db-models/repos/onfinance-db-model-master/onfinance_db_model_master/models.py:3"},{"type":"workspace-file","ref":"applications/db-models/repos/onfinance-db-model-master/onfinance_db_model_master/models.py:406"},{"type":"workspace-file","ref":"company-profile/example-co/sdlc/metastore.json"}],"provenance":{"harness":"claude-code","generatedAt":"2026-09-14T11:10:49Z","sessionId":"cb91f6b0-eba0-4378-9168-48137e203b72","runId":"run_01M2FGNVVQ15ZKXZWGW74YWAAQ","workflow":"refresh-metastore","agent":"soc-ledger-keeper"}}
