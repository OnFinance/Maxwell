diff --git a/src/tools/mongodb/dataClassification.ts b/src/tools/mongodb/dataClassification.ts
new file mode 100644
index 0000000..670968a
--- /dev/null
+++ b/src/tools/mongodb/dataClassification.ts
@@ -0,0 +1,32 @@
+import type { z } from "zod";
+
+// Data classification labels for MongoDB MCP tool arguments. Filters, projections, documents, updates and
+// aggregation stages are forwarded to the connected cluster, whose client-data and order collections hold
+// personal and financial data, so these arguments take the highest classification of the connected stores.
+// The labels are published in the JSON Schema of each argument so MCP clients and gateways can apply
+// personal-data handling rules (masking, logging, retention) without parsing the prose descriptions.
+export const DATA_CLASSIFICATION_LEVELS = ["public", "internal", "confidential", "restricted"] as const;
+export const DATA_CLASSIFICATION_FLAGS = ["pii", "spdi", "financial"] as const;
+
+export type DataClassificationLabel =
+    | (typeof DATA_CLASSIFICATION_LEVELS)[number]
+    | (typeof DATA_CLASSIFICATION_FLAGS)[number];
+
+export const DATA_CLASSIFICATION_META_KEY = "x-data-classification";
+export const DPDP_CATEGORY_META_KEY = "x-dpdp-category";
+
+export const CLIENT_DATA_CLASSIFICATION: readonly DataClassificationLabel[] = ["restricted", "pii", "financial"];
+
+/**
+ * Attaches data classification metadata to a schema. Only metadata is added: the returned schema accepts
+ * and rejects exactly the same values as the input schema.
+ */
+export function withClassification<T extends z.ZodType>(
+    schema: T,
+    labels: readonly DataClassificationLabel[] = CLIENT_DATA_CLASSIFICATION
+): T {
+    return schema.meta({
+        [DATA_CLASSIFICATION_META_KEY]: [...labels],
+        [DPDP_CATEGORY_META_KEY]: "personal-data",
+    });
+}
