diff --git a/tests/unit/tools/mongodb/dataClassification.test.ts b/tests/unit/tools/mongodb/dataClassification.test.ts
new file mode 100644
index 0000000..f1cb0ee
--- /dev/null
+++ b/tests/unit/tools/mongodb/dataClassification.test.ts
@@ -0,0 +1,35 @@
+import { describe, it, expect } from "vitest";
+import { z } from "zod";
+import { zEJSON } from "../../../../src/tools/args.js";
+import { AnyAggregateStage, VectorSearchStage } from "../../../../src/tools/mongodb/mongodbSchemas.js";
+import { FindArgs } from "../../../../src/tools/mongodb/read/find.js";
+import {
+    CLIENT_DATA_CLASSIFICATION,
+    DATA_CLASSIFICATION_META_KEY,
+    DPDP_CATEGORY_META_KEY,
+} from "../../../../src/tools/mongodb/dataClassification.js";
+
+function inputJsonSchema(schema: z.ZodType): Record<string, unknown> {
+    return z.toJSONSchema(schema, { io: "input" }) as Record<string, unknown>;
+}
+
+describe("data classification metadata", () => {
+    it.each([
+        ["zEJSON", zEJSON()],
+        ["AnyAggregateStage", AnyAggregateStage],
+        ["VectorSearchStage", VectorSearchStage],
+        ["FindArgs.filter", FindArgs.filter],
+        ["FindArgs.projection", FindArgs.projection],
+    ] as [string, z.ZodType][])("%s advertises x-data-classification in its JSON Schema", (_name, schema) => {
+        const jsonSchema = inputJsonSchema(schema);
+        expect(jsonSchema[DATA_CLASSIFICATION_META_KEY]).toEqual([...CLIENT_DATA_CLASSIFICATION]);
+        expect(jsonSchema[DPDP_CATEGORY_META_KEY]).toBe("personal-data");
+    });
+
+    it("does not change which arguments are accepted", () => {
+        expect(zEJSON().parse({ name: "value" })).toEqual({ name: "value" });
+        expect(() => zEJSON().parse("not-an-object")).toThrow();
+        expect(FindArgs.projection.parse({ name: 1 })).toEqual({ name: 1 });
+        expect(FindArgs.projection.parse(undefined)).toBeUndefined();
+    });
+});
