diff --git a/src/tools/args.ts b/src/tools/args.ts
index f670b9e..99cb16b 100644
--- a/src/tools/args.ts
+++ b/src/tools/args.ts
@@ -83,8 +83,79 @@ export function toEJSON<T extends object | undefined>(value: T): T {
     return EJSON.deserialize(value, { relaxed: false }) as T;
 }

+export const MAX_EJSON_BYTES = 1_048_576;
+export const MAX_EJSON_DEPTH = 20;
+export const MAX_EJSON_KEYS = 200;
+const FORBIDDEN_EJSON_OPERATORS = ["$where", "$function", "$accumulator"];
+
+export const EJSON_TOO_LARGE_ERROR = `Argument must be ${MAX_EJSON_BYTES} bytes or less when serialized as JSON`;
+export const EJSON_TOO_DEEP_ERROR = `Argument cannot be nested more than ${MAX_EJSON_DEPTH} levels deep`;
+export const EJSON_TOO_MANY_KEYS_ERROR = `Objects in the argument cannot have more than ${MAX_EJSON_KEYS} keys`;
+export const EJSON_FORBIDDEN_OPERATOR_ERROR =
+    "Argument cannot contain the server-side JavaScript operators $where, $function or $accumulator";
+
+function findNestedEJSONViolation(value: unknown, depth: number): string | undefined {
+    if (value === null || typeof value !== "object") {
+        return undefined;
+    }
+
+    if (depth > MAX_EJSON_DEPTH) {
+        return EJSON_TOO_DEEP_ERROR;
+    }
+
+    if (Array.isArray(value)) {
+        for (const item of value) {
+            const violation = findNestedEJSONViolation(item, depth + 1);
+            if (violation) {
+                return violation;
+            }
+        }
+        return undefined;
+    }
+
+    const keys = Object.keys(value);
+    if (keys.length > MAX_EJSON_KEYS) {
+        return EJSON_TOO_MANY_KEYS_ERROR;
+    }
+
+    for (const key of keys) {
+        if (FORBIDDEN_EJSON_OPERATORS.includes(key)) {
+            return EJSON_FORBIDDEN_OPERATOR_ERROR;
+        }
+
+        const violation = findNestedEJSONViolation((value as Record<string, unknown>)[key], depth + 1);
+        if (violation) {
+            return violation;
+        }
+    }
+
+    return undefined;
+}
+
+function getEJSONLimitViolation(value: object): string | undefined {
+    const violation = findNestedEJSONViolation(value, 1);
+    if (violation) {
+        return violation;
+    }
+
+    // Measured only after the depth check passed, so JSON.stringify never walks an unbounded structure
+    if (Buffer.byteLength(JSON.stringify(value), "utf8") > MAX_EJSON_BYTES) {
+        return EJSON_TOO_LARGE_ERROR;
+    }
+
+    return undefined;
+}
+
 // The runtime schema is a ZodPipe (object → EJSON transform), but we advertise
 // it as a ZodRecord so the public API surface renders cleanly as { [key: string]: unknown }
 export function zEJSON(): z.ZodRecord<z.ZodString, z.ZodUnknown> {
-    return z.object({}).loose().transform(toEJSON) as unknown as z.ZodRecord<z.ZodString, z.ZodUnknown>;
+    return z
+        .looseObject({})
+        .superRefine((value, ctx) => {
+            const violation = getEJSONLimitViolation(value);
+            if (violation) {
+                ctx.addIssue({ code: "custom", message: violation });
+            }
+        })
+        .transform(toEJSON) as unknown as z.ZodRecord<z.ZodString, z.ZodUnknown>;
 }
