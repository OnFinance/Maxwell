     steps:
       - name: Check out code
         uses: actions/checkout@v6
@@ -69,11 +66,37 @@ jobs:
       - name: Set up Docker Buildx
         uses: docker/setup-buildx-action@d7f5e7f509e45cec5c76c4d5afdd7de93d0b3df5

+      - name: Configure AWS credentials via OIDC
+        uses: aws-actions/configure-aws-credentials@cbe3b392738ccf3f987d68400dafcf4b0624a56c
+        with:
+          role-to-assume: "${{ vars.DOCKERHUB_PUBLISH_ROLE_ARN }}"
+          aws-region: "${{ vars.DOCKERHUB_PUBLISH_AWS_REGION }}"
+
+      - name: Read Docker Hub token from AWS Secrets Manager
+        id: dockerhub-credentials
+        env:
+          DOCKERHUB_SECRET_ID: "${{ vars.DOCKERHUB_TOKEN_SECRET_ID }}"
+        run: |
+          set -euo pipefail
+
+          SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "$DOCKERHUB_SECRET_ID" --query SecretString --output text)
+          DOCKERHUB_USER=$(jq -r '.username // empty' <<< "$SECRET_JSON")
+          DOCKERHUB_TOKEN=$(jq -r '.token // empty' <<< "$SECRET_JSON")
+
+          if [[ -z "$DOCKERHUB_USER" || -z "$DOCKERHUB_TOKEN" ]]; then
+            echo "::error::Secret $DOCKERHUB_SECRET_ID must contain username and token keys"
+            exit 1
+          fi
+
+          echo "::add-mask::$DOCKERHUB_TOKEN"
+          echo "username=$DOCKERHUB_USER" >> "$GITHUB_OUTPUT"
+          echo "token=$DOCKERHUB_TOKEN" >> "$GITHUB_OUTPUT"
+
       - name: Login to Docker Hub
         uses: docker/login-action@650006c6eb7dba73a995cc03b0b2d7f5ca915bee
         with:
-          username: "${{ secrets.DOCKERHUB_USERNAME }}"
-          password: "${{ secrets.DOCKERHUB_PASSWORD }}"
+          username: "${{ steps.dockerhub-credentials.outputs.username }}"
+          password: "${{ steps.dockerhub-credentials.outputs.token }}"

       - name: Build and push image to dockerhub registry
         uses: docker/build-push-action@f9f3042f7e2789586610d6e8b85c8f03e5195baf
