+"""Model tests asserting no credential field round-trips unencrypted.
+
+Secrets credential fields must persist AES-256-GCM envelope-encrypted and
+decrypt on load (to_mongo is the mongoengine save path, to_python the load
+path), user passwords must persist only as bcrypt hashes, and exchange
+credentials must be locator references. Run from the repo root:
+
+    python -m unittest discover -s tests
+"""
+
+import base64
+import os
+import unittest
+
+from onfinance_db_model_master.models import Secrets, User, check_password
+
+
+class CredentialStorageTestCase(unittest.TestCase):
+    """Persist (to_mongo), reload (to_python), compare with the plaintext input."""
+
+    def setUp(self):
+        self._previous_key = os.environ.get("DB_MODELS_AES_KEY")
+        os.environ["DB_MODELS_AES_KEY"] = base64.urlsafe_b64encode(
+            os.urandom(32)
+        ).decode("ascii")
+
+    def tearDown(self):
+        if self._previous_key is None:
+            os.environ.pop("DB_MODELS_AES_KEY", None)
+        else:
+            os.environ["DB_MODELS_AES_KEY"] = self._previous_key
+
+    def test_secret_fields_persist_encrypted_and_reload(self):
+        plaintexts = dict(
+            apiKey="api key input",
+            zerodha_password="password input",
+            zerodha_2fa="2fa seed input",
+            apiSecrets="api secret input",
+            accessToken="access token input",
+        )
+        document = Secrets(accountName="account", zerodha_username="user", **plaintexts)
+        stored = document.to_mongo()
+        for name, plaintext in plaintexts.items():
+            stored_value = stored[name]
+            self.assertTrue(stored_value.startswith("enc:v1:"))
+            self.assertNotIn(plaintext, str(stored))
+            reloaded = Secrets._fields[name].to_python(stored_value)
+            self.assertEqual(reloaded, plaintext)
+
+    def test_legacy_cleartext_rows_stay_readable_pending_migration(self):
+        field = Secrets._fields["zerodha_password"]
+        self.assertEqual(field.to_python("legacy plaintext row"), "legacy plaintext row")
+
+    def test_user_password_persists_only_as_bcrypt_hash(self):
+        field = User._fields["user_password"]
+        stored = field.to_mongo("plaintext password input")
+        self.assertTrue(stored.startswith("$2"))
+        self.assertNotEqual(stored, "plaintext password input")
+        self.assertNotIn("plaintext password input", stored)
+        self.assertTrue(check_password(stored, "plaintext password input"))
+        self.assertFalse(check_password(stored, "wrong password input"))
+        self.assertFalse(check_password("legacy raw value", "legacy raw value"))
+        self.assertEqual(field.to_python(stored), stored)
+
+    def test_user_password_hashes_legacy_bytes_writes(self):
+        field = User._fields["user_password"]
+        stored = field.to_mongo(b"legacy bytes password")
+        self.assertTrue(stored.startswith("$2"))
+        self.assertTrue(check_password(stored, b"legacy bytes password"))
+
+    def test_user_binance_auth_creds_holds_locator_references_only(self):
+        document = User(
+            user_full_name="user",
+            user_binance_auth_creds=["aws-secrets-manager secret locator"],
+        )
+        stored = document.to_mongo()
+        self.assertEqual(
+            stored["user_binance_auth_creds"], ["aws-secrets-manager secret locator"]
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
