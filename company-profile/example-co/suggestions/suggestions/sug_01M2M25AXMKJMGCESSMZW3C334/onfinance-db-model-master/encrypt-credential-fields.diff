+import base64
+import os
 import re
+import bcrypt
 from bson import DBRef
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
 from mongoengine import Document, EmailField, BinaryField, DynamicField
 from mongoengine import DateTimeField, EmbeddedDocument, StringField, URLField
 from mongoengine import ReferenceField, EmbeddedDocumentListField, ListField
 from mongoengine import IntField, FloatField, BooleanField, DateField, DictField
 
+# Credential values are never persisted in cleartext: the Secrets credential
+# fields are AES-256-GCM envelope-encrypted on save and decrypted on load,
+# user passwords are stored only as irreversible bcrypt hashes, and exchange
+# credentials are reduced to secrets-manager locator references, per
+# sdlc/policy.json secretsManagement.backend (aws-secrets-manager, KMS-backed).
+# The 32-byte data key is injected through the DB_MODELS_AES_KEY environment
+# variable (urlsafe-base64). Values without the markers below are legacy
+# cleartext rows: reads pass them through unchanged and the next save upgrades
+# them; run the one-off migration task to cover rows that are never rewritten.
+
+_CIPHERTEXT_MARKER = "enc:v1:"
+_KEY_ENV_VAR = "DB_MODELS_AES_KEY"
+
+
+def _load_data_key():
+    encoded = os.environ.get(_KEY_ENV_VAR, "")
+    try:
+        key = base64.urlsafe_b64decode(encoded + "=" * (-len(encoded) % 4))
+    except Exception:
+        key = b""
+    if len(key) != 32:
+        raise RuntimeError(
+            _KEY_ENV_VAR
+            + " must hold a 32-byte urlsafe-base64 key (AES-256-GCM); "
+            + "provision it from the KMS-backed secrets backend"
+        )
+    return key
+
+
+def _encrypt_value(plaintext):
+    nonce = os.urandom(12)
+    ciphertext = AESGCM(_load_data_key()).encrypt(
+        nonce, plaintext.encode("utf-8"), None
+    )
+    return _CIPHERTEXT_MARKER + base64.urlsafe_b64encode(nonce + ciphertext).decode(
+        "ascii"
+    )
+
+
+def _decrypt_value(stored):
+    token = stored[len(_CIPHERTEXT_MARKER):]
+    blob = base64.urlsafe_b64decode(token + "=" * (-len(token) % 4))
+    nonce, ciphertext = blob[:12], blob[12:]
+    return AESGCM(_load_data_key()).decrypt(nonce, ciphertext, None).decode("utf-8")
+
+
+class EncryptedStringField(StringField):
+    """StringField whose value is AES-256-GCM envelope-encrypted at rest.
+
+    to_mongo encrypts on save, so serialised documents (to_mongo/to_json)
+    carry ciphertext only; to_python decrypts again on load. Values without
+    the marker are legacy cleartext rows pending migration and pass through
+    unchanged. Equality queries cannot match AEAD ciphertext with a random
+    nonce; look credentials up by accountName or zerodha_username instead.
+    """
+
+    def to_mongo(self, value):
+        if value is None:
+            return value
+        if isinstance(value, str) and value.startswith(_CIPHERTEXT_MARKER):
+            return value
+        return _encrypt_value(value)
+
+    def to_python(self, value):
+        if not isinstance(value, str) or not value.startswith(_CIPHERTEXT_MARKER):
+            return value
+        return _decrypt_value(value)
+
+
+class PasswordHashField(StringField):
+    """Field that persists only an irreversible bcrypt hash of the password."""
+
+    def to_mongo(self, value):
+        if value is None:
+            return value
+        if isinstance(value, str) and value.startswith("$2"):
+            return value
+        secret = value.encode("utf-8") if isinstance(value, str) else bytes(value)
+        return bcrypt.hashpw(secret, bcrypt.gensalt()).decode("ascii")
+
+    def to_python(self, value):
+        if isinstance(value, bytes):
+            return value.decode("utf-8", "replace")
+        return value
+
+    def validate(self, value, **kwargs):
+        if value is None or isinstance(value, (str, bytes)):
+            return
+        self.error("PasswordHashField only accepts string or bytes values")
+
+
+def check_password(stored_hash, candidate):
+    """Constant-time bcrypt verification of a candidate password."""
+    if not isinstance(stored_hash, str) or not stored_hash.startswith("$2"):
+        return False
+    if isinstance(candidate, str):
+        candidate = candidate.encode("utf-8")
+    return bcrypt.checkpw(bytes(candidate), stored_hash.encode("ascii"))
+
+
