{
  "target": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/claude-command.schema.json",
  "tests": [
    {
      "description": "/validate command frontmatter",
      "valid": true,
      "data": {
        "description": "Run every Maxwell validator (layout, schemas, data, frontmatter, workflows, mirror) and report problems by path",
        "argument-hint": "[path ...]",
        "allowed-tools": [
          "Bash(npm run validate*)",
          "Bash(node .claude/scripts/*)",
          "Read"
        ],
        "model": "sonnet",
        "effort": "low",
        "disable-model-invocation": false,
        "user-invocable": true,
        "x-maxwell": {
          "workflow": "validate",
          "touches": [],
          "readsCredentials": false
        }
      }
    },
    {
      "description": "seed-company command that writes a company profile via a forked agent",
      "valid": true,
      "data": {
        "description": "Create the skeleton company-profile/<company_id> tree for a new regulated entity",
        "argument-hint": "<company_id> --entity=<entity-type>",
        "allowed-tools": "Read Write Bash(node .claude/scripts/*)",
        "context": "fork",
        "agent": "company-context",
        "model": "claude-opus-5",
        "x-maxwell": {
          "workflow": "seed-company",
          "touches": [
            "company-profile/*/**"
          ],
          "readsCredentials": false
        }
      }
    },
    {
      "description": "command with named arguments, a background fork and a disallowed-tools string",
      "valid": true,
      "data": {
        "description": "Create the skeleton company-profile/<company_id> tree for a new regulated entity",
        "argument-hint": "<company_id> --entity=<entity-type>",
