        "model": "claude-opus-5",
        "x-maxwell": {
          "workflow": "seed-company",
          "touches": [
            "company-profile/*/**"
          ],
          "readsCredentials": false
        },
        "arguments": [
          "company_id",
          "entity"
        ],
        "background": true,
        "disallowed-tools": "WebFetch, WebSearch"
      }
    },
