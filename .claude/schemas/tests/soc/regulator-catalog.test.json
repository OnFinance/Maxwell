        "groups": [
          {
            "id": "GV.SC",
            "title": "Govern: Cybersecurity Supply Chain Risk Management",
            "controls": [
              {
                "id": "GV.SC.S5",
                "title": "Software Bill of Materials for critical systems",
                "prose": "REs shall obtain a Software Bill of Materials (SBOM) for all critical systems and for every new critical software procured, listing components, versions, licences and known vulnerabilities, and shall keep it updated on every release",
                "guidance": "Generate CycloneDX or SPDX from the build pipeline and store the reference under applications/<app_id>/images/<image_id>.cdx.json",
                "category": "GV.SC",
                "applicability": {
                  "reCategories": [
                    "mii",
                    "qualified-re",
                    "mid-size-re"
                  ],
                  "entityTypes": [
                    "stock-broker",
                    "market-infrastructure-institution"
                  ]
                },
                "mandatory": true,
                "defaultSeverity": "high",
                "cadence": "event-driven",
                "evidenceExpected": [
                  "CycloneDX SBOM per production image",
                  "Pipeline step that regenerates SBOM on release"
                ],
                "mappings": [
                  {
                    "regulator": "NIST",
                    "instrument": "nist-ssdf-800-218",
                    "controlId": "PS.3.2"
                  }
                ],
                "probeWorkflows": [
                  "probe-cicd-env",
                  "probe-app-chart"
                ],
                "params": [
                  {
                    "id": "sbomFormat",
                    "label": "SBOM format accepted for critical systems",
                    "default": "cyclonedx-1.6"
                  }
                ]
              }
            ]
          }
        ],
        "provenance": {
