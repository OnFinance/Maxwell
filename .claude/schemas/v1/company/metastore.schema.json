{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxwell.onfinance.ai/schemas/v1/company/metastore.schema.json",
  "title": "Data metastore snapshot",
  "description": "Schema for company-profile/<company_id>/sdlc/metastore.json, a point-in-time inventory of the company's data catalogs, tables and columns with classification, the pipelines that move data, and OpenLineage-style lineage edges. refresh-metastore rewrites the whole file; runtime-probe-datapipeline reads it to find where regulated data flows",
  "examples": [
    {
      "schemaVersion": "1",
      "kind": "maxwell.company.metastore",
      "companyId": "zenith-securities",
      "snapshotAt": "2026-09-13T02:00:00Z",
      "catalogs": [
        {
          "catalogId": "prod-unity",
          "type": "unity",
          "endpointRef": "prod-unity-catalog-ro",
          "appId": "data-platform",
          "schemas": [
            {
              "name": "trading",
              "tables": [
                {
                  "name": "client_orders",
                  "fullyQualifiedName": "prod.trading.client_orders",
                  "columns": [
                    {
                      "name": "client_code",
                      "dataType": "string",
                      "dataClassification": [ "confidential", "pii" ],
                      "pii": true
                    },
                    {
                      "name": "order_value_inr",
                      "dataType": "decimal(18,2)",
                      "dataClassification": [ "financial" ],
                      "pii": false
                    }
                  ],
                  "owner": "data-eng@zenithsecurities.in",
                  "retentionDays": 2920,
                  "rowCountEstimate": 184000000,
                  "location": "s3://zenith-prod-lake/trading/client_orders",
                  "format": "delta"
                }
              ]
            }
          ]
        }
      ],
      "pipelines": [
        {
          "pipelineId": "orders-daily-load",
          "name": "Orders daily load from OMS",
          "orchestrator": "databricks-workflows",
          "schedule": "30 18 * * 1-5",
          "owner": "data-eng@zenithsecurities.in",
          "sourceRepo": {
            "appId": "data-platform",
            "repoId": "airflow-dags"
          }
        }
      ],
      "lineage": [
        {
          "job": {
            "namespace": "databricks://prod-workspace",
            "name": "orders-daily-load.load_orders"
          },
          "inputs": [
            {
              "namespace": "postgres://oms-db.internal:5432",
              "name": "oms.public.orders"
            }
          ],
          "outputs": [
            {
              "namespace": "s3://zenith-prod-lake",
              "name": "trading/client_orders"
            }
          ],
          "facets": {
            "columnLineage": "client_code<-postgres://oms-db.internal:5432/oms.public.orders.client_code;order_value_inr<-postgres://oms-db.internal:5432/oms.public.orders.value"
          }
        }
      ],
      "provenance": {
        "harness": "claude-code",
        "generatedAt": "2026-09-13T02:05:00Z",
        "runId": "run_01J9Z6X3F8N2Q4R5S6T7V8W9XB",
        "workflow": "refresh-metastore",
        "agent": "metastore-crawler"
      }
    }
  ],
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "snapshotAt",
    "catalogs",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "maxwell.company.metastore"
    },
    "companyId": {
      "description": "Slug of the owning company; must equal the company-profile/<company_id> folder name when present",
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/slug"
    },
    "snapshotAt": {
      "description": "When the catalogs were crawled; the whole file describes state as of this instant",
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/timestamp"
    },
    "catalogs": {
      "description": "Every data catalog or metastore that was crawled, with its schemas, tables and columns",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/catalog"
      }
    },
    "pipelines": {
      "description": "Scheduled or streaming jobs that move or transform data between the catalogued tables",
      "type": "array",
      "maxItems": 2000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pipeline"
      }
    },
    "lineage": {
      "description": "Job runs that read input datasets and write output datasets, using OpenLineage job, inputs and outputs conventions",
      "type": "array",
      "maxItems": 20000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/lineageEdge"
      }
    },
    "openMetadataExport": {
      "description": "Optional raw OpenMetadata entity export kept for traceability; keys are OpenMetadata entity fields and are not interpreted by Maxwell. Capped at 50 top-level scalar values so a full export cannot bloat the profile; store a larger export outside the workspace and reference it from a soc observation evidenceRef instead of embedding it",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4000
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "provenance": {
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/provenance"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "catalog": {
      "type": "object",
      "required": [ "catalogId", "type", "endpointRef", "appId", "schemas" ],
      "properties": {
        "catalogId": {
          "description": "Slug naming the catalog inside this workspace, for example prod-unity or glue-analytics",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/slug"
        },
        "type": {
          "description": "Catalog technology; rdbms is a plain database information_schema crawled without a catalog product",
          "enum": [
            "hive",
            "unity",
            "glue",
            "bigquery",
            "snowflake",
            "openmetadata",
            "datahub",
            "rdbms",
            "other"
          ]
        },
        "endpointRef": {
          "description": "Key of the entry in applications/<app_id>/credentials.json (appId) that resolves to the catalog endpoint and token, in the credentials key format (lowercase, starts with a letter); never a URL and never a secret value",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/credentialKey"
        },
        "appId": {
          "description": "Application whose credentials.json holds the endpointRef entry",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/slug"
        },
        "schemas": {
          "description": "Schemas (databases, datasets) inside the catalog",
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/schemaEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "schemaEntry": {
      "type": "object",
      "required": [ "name", "tables" ],
      "properties": {
        "name": {
          "description": "Schema or dataset name as known to the catalog",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "tables": {
          "description": "Tables and views in the schema",
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/table"
          }
        }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": [ "name", "fullyQualifiedName", "columns" ],
      "properties": {
        "name": {
          "description": "Table or view name",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "fullyQualifiedName": {
          "description": "Catalog-qualified name such as prod.trading.client_orders, unique within the catalog",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/nonEmptyString"
        },
        "columns": {
          "description": "Columns with their data classification; empty when the crawler could not read the schema",
          "type": "array",
          "maxItems": 2000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "owner": {
          "description": "Owning team or person, usually an email or group alias",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "retentionDays": {
          "description": "Retention period applied to rows; SEBI and RBI expect 8 years (2920 days) for many trading and KYC records",
          "type": "integer",
          "minimum": 0
        },
        "rowCountEstimate": {
          "description": "Approximate row count at snapshotAt",
          "type": "integer",
          "minimum": 0
        },
        "location": {
          "description": "Physical storage URI such as s3://bucket/prefix or gs://bucket/prefix",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/nonEmptyString"
        },
        "format": {
          "description": "Storage format of the table",
          "enum": [
            "parquet",
            "delta",
            "iceberg",
            "hudi",
            "orc",
            "avro",
            "csv",
            "json",
            "native",
            "view",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "if": {
        "required": [ "pii" ],
        "properties": {
          "pii": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "dataClassification": {
            "contains": {
              "const": "pii"
            }
          }
        }
      },
      "else": {
        "properties": {
          "dataClassification": {
            "not": {
              "contains": {
                "const": "pii"
              }
            }
          }
        }
      },
      "required": [ "name", "dataType", "dataClassification", "pii" ],
      "properties": {
        "name": {
          "description": "Column name",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "dataType": {
          "description": "Data type as reported by the catalog, for example string, bigint, decimal(18,2)",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "dataClassification": {
          "description": "Data classifications that apply to the column, named as in application/environment.schema.json; use internal when no sensitive class applies. Must include pii exactly when pii is true",
          "type": "array",
          "maxItems": 9,
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://maxwell.onfinance.ai/schemas/vocab/statuses.schema.json#/$defs/dataClassification"
          }
        },
        "pii": {
          "description": "True when the column identifies a natural person on its own or in combination, per DPDP Act personal-data definition; must agree with dataClassification containing pii",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "required": [ "pipelineId", "name", "orchestrator", "owner" ],
      "properties": {
        "pipelineId": {
          "description": "Slug identifying the pipeline, stable across snapshots",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/slug"
        },
        "name": {
          "description": "Human-readable pipeline name as shown in the orchestrator",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "orchestrator": {
          "description": "System that schedules or runs the pipeline",
          "enum": [
            "airflow",
            "dagster",
            "prefect",
            "dbt",
            "spark",
            "kafka-connect",
            "databricks-workflows",
            "glue",
            "custom"
          ]
        },
        "schedule": {
          "description": "Cron expression or plain-language schedule; omit for event-driven and streaming pipelines",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "owner": {
          "description": "Owning team or person, usually an email or group alias",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "sourceRepo": {
          "description": "Repository holding the pipeline code, by workspace application and repo id",
          "type": "object",
          "required": [ "appId", "repoId" ],
          "properties": {
            "appId": {
              "description": "Application slug under applications/",
              "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/slug"
            },
            "repoId": {
              "description": "Repo slug under applications/<app_id>/repos/",
              "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/slug"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dataset": {
      "description": "OpenLineage dataset identity: namespace is the data source URI (scheme://authority) and name is the path or table inside it",
      "type": "object",
      "required": [ "namespace", "name" ],
      "properties": {
        "namespace": {
          "description": "Dataset namespace per OpenLineage naming, for example postgres://host:5432, s3://bucket, bigquery",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "name": {
          "description": "Dataset name inside the namespace, for example db.schema.table or a key prefix",
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "lineageEdge": {
      "description": "One OpenLineage run: a job reading input datasets and writing output datasets",
      "type": "object",
      "required": [ "job", "inputs", "outputs" ],
      "properties": {
        "job": {
          "description": "OpenLineage job identity",
          "type": "object",
          "required": [ "namespace", "name" ],
          "properties": {
            "namespace": {
              "description": "OpenLineage job namespace, typically the orchestrator instance such as airflow://prod",
              "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
            },
            "name": {
              "description": "OpenLineage job name, typically dag.task for Airflow",
              "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
            }
          },
          "additionalProperties": false
        },
        "inputs": {
          "description": "Datasets the job reads; empty for source-only jobs",
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        },
        "outputs": {
          "description": "Datasets the job writes; empty for sink-only jobs",
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        },
        "facets": {
          "description": "Optional OpenLineage facets copied from the run event, values flattened to strings and keyed by facet name. columnLineage uses the form outputField<-namespace/name.inputField with entries separated by semicolons so runtime-probe-datapipeline can trace PII columns. Capped at 20 keys because facets are informational only",
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/nonEmptyString"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
