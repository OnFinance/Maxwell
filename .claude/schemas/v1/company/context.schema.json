      "properties": {
        "questionId": {
          "$ref": "#/$defs/localId"
        },
        "question": {
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
        },
        "answer": {
          "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/longText"
        },
        "status": {
          "description": "answered from a source or by a human; open when nothing could ground an answer (a human is asked in chat); not-applicable when the obligation does not reach this company",
          "enum": [ "answered", "open", "not-applicable" ]
        },
        "answeredBy": {
          "enum": [ "research", "human" ]
        },
        "confidence": {
          "enum": [ "high", "medium", "low" ]
        },
        "evidence": {
