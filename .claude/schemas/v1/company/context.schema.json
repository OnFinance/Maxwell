  "properties": {
    "schemaVersion": {
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "maxwell.company.context"
    },
    "companyId": {
      "description": "Slug identifying the company; must equal the company-profile/<company_id> folder name",
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/slug"
    },
    "status": {
      "description": "complete when every question is answered or not-applicable; in_progress while questions are open; pending before the first refresh-ctx run finished",
      "enum": [ "pending", "in_progress", "complete" ]
    },
    "summary": {
      "description": "One-paragraph note of what the company is, where it is based and what it offers, in plain words",
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/longText"
    },
    "businessUnits": {
      "description": "Lines of business, each holding licenses, carrying company-level obligations and owning processes",
      "type": "array",
      "maxItems": 32,
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/businessUnit"
      }
    },
    "licenses": {
      "description": "Every licence or registration in details.json regulatoryRegistrations, placed under a business unit",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/license"
      }
    },
    "obligations": {
      "description": "Obligation sets a regulator or statute places on a unit or a licence; each raises exactly one questionnaire",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "questionnaires": {
      "description": "The questions an obligation raises about how the company operates, with answers grounded in fetched sources or given by a human",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/questionnaire"
      }
    },
    "processes": {
      "description": "Operational processes the answers reveal, each tied to the obligations that require it",
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/process"
      }
    },
    "offerings": {
      "description": "Products and services offered under a licence",
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/offering"
      }
    },
    "customerSegments": {
      "description": "Customer segments the offerings serve",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/customerSegment"
      }
    },
    "platforms": {
      "description": "Platforms and supporting functions that deliver the offerings, linked to applications/<app_id> and to the cybersecurity instruments that bind them",
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "provenance": {
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/provenance"
    }
  },
  "additionalProperties": false,
  "$defs": {
