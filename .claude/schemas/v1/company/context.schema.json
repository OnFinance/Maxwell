        },
        "source": {
          "description": "Where the obligation comes from: an instrument in the vocabulary, a statute, a circular or a register entry",
          "type": "object",
          "required": [ "type", "ref" ],
          "properties": {
            "type": {
              "enum": [ "instrument", "statute", "circular", "register" ]
            },
            "ref": {
              "description": "The vocab instrument id when type is instrument, otherwise the title of the statute, circular or register",
              "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/shortText"
            },
            "url": {
              "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/url"
