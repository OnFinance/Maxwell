          "purl": "pkg:deb/debian/libssl3@3.0.14-1~deb12u2?arch=amd64&distro=debian-12",
          "supplier": {
            "name": "Debian OpenSSL Team"
          }
        }
      ],
      "dependencies": [
        {
          "ref": "image:ledger-core-api",
          "dependsOn": [ "pkg:npm/express@4.21.2", "os:debian@12.7" ]
        },
        {
          "ref": "pkg:npm/express@4.21.2",
