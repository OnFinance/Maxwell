      "bomFormat": "CycloneDX",
      "specVersion": "1.6",
      "serialNumber": "urn:uuid:3e671687-395b-41f5-a30f-a58921a69b79",
      "version": 1,
      "metadata": {
        "timestamp": "2026-09-13T04:01:30Z",
        "tools": {
          "components": [
            {
              "type": "application",
              "name": "syft",
              "version": "1.30.0",
              "bom-ref": "tool:syft"
            }
          ]
        },
        "component": {
          "type": "container",
          "name": "123456789012.dkr.ecr.ap-south-1.amazonaws.com/arthanidhi/ledger-core-api",
          "version": "sha256:7c9e6b1f4a2d3e5f8a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f",
          "bom-ref": "image:ledger-core-api",
          "purl": "pkg:oci/ledger-core-api@sha256%3A7c9e6b1f4a2d3e5f8a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f?repository_url=123456789012.dkr.ecr.ap-south-1.amazonaws.com/arthanidhi/ledger-core-api&tag=2.14.3"
        },
        "properties": [
          {
            "name": "maxwell:runId",
            "value": "run_01J7Q8Z2N3M4P5R6S7T8V9W0X1"
          },
          {
            "name": "maxwell:sessionId",
            "value": "2f1c3a4e-8b7d-4c6e-9f0a-1b2c3d4e5f60"
          },
          {
            "name": "maxwell:workflow",
            "value": "runtime-probe-appcontainers"
          },
          {
            "name": "maxwell:imageId",
            "value": "ledger-core-api"
          }
        ]
      },
      "components": [
        {
          "type": "operating-system",
          "name": "debian",
          "version": "12.7",
          "bom-ref": "os:debian@12.7",
          "cpe": "cpe:2.3:o:debian:debian_linux:12.7:*:*:*:*:*:*:*"
        },
        {
