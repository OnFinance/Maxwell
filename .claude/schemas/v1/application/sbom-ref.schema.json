          "bom-ref": "pkg:npm/express@4.21.2",
          "purl": "pkg:npm/express@4.21.2",
          "licenses": [
            {
              "license": {
                "id": "MIT"
              }
            }
          ],
          "hashes": [
            {
              "alg": "SHA-512",
              "content": "0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e"
            }
          ],
          "properties": [
            {
              "name": "syft:package:foundBy",
