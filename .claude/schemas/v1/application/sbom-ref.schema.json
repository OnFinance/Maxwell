        }
      ],
      "vulnerabilities": [
        {
          "id": "CVE-2024-5535",
          "bom-ref": "vuln:CVE-2024-5535",
          "source": {
            "name": "NVD",
            "url": "https://nvd.nist.gov/vuln/detail/CVE-2024-5535"
