{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxwell.onfinance.ai/schemas/v1/harness/toolchain.schema.json",
  "title": "Pinned toolchain",
  "description": "Schema for .claude/skills/scanner-toolchain/references/toolchain.json: every scanner, runtime CLI and helper Maxwell runs, pinned by exact version, per-platform release artifact sha256, OCI image digest and, for Python tools, a hash-locked requirements file. toolchain/scan.mjs and sandbox/exec.mjs run nothing that is not pinned here",
  "examples": [
    {
      "schemaVersion": "1",
      "kind": "maxwell.toolchain",
      "pinnedAt": "2026-09-14T15:40:00Z",
      "platforms": [ "linux-amd64", "linux-arm64", "darwin-arm64" ],
      "tools": [
        {
          "name": "gitleaks",
          "category": "scanner",
          "version": "8.30.1",
          "source": "https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1",
          "versionCheck": {
            "args": [ "version" ],
            "expect": "8.30.1"
          },
          "artifacts": {
            "linux-amd64": {
              "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz",
              "sha256": "0d3a8a3fd1cc0e3b3eb5b3e0c8c3e1a4b7d1a4f3c2a5b6c7d8e9f0a1b2c3d4e5",
              "sha256Source": "upstream-checksums-verified",
              "archive": "tar.gz",
              "binaryPath": "gitleaks",
              "verifiedVersionOutput": "8.30.1"
            }
          },
          "image": {
            "ref": "ghcr.io/gitleaks/gitleaks:v8.30.1",
            "digest": "sha256:1f2e3d4c5b6a79808f7e6d5c4b3a29181f0e1d2c3b4a59687f6e5d4c3b2a1908",
            "invoke": "gitleaks",
            "user": "",
            "platforms": [ "linux/amd64", "linux/arm64" ]
          }
        },
        {
          "name": "semgrep",
          "category": "scanner",
          "version": "1.177.0",
          "source": "https://pypi.org/project/semgrep/1.177.0/",
          "versionCheck": {
            "args": [ "--version" ],
            "expect": "1.177.0"
          },
          "python": {
            "package": "semgrep",
            "lock": "locks/semgrep.txt",
            "lockSha256": "9a8b7c6d5e4f30211f2e3d4c5b6a79808f7e6d5c4b3a29181f0e1d2c3b4a5968",
            "packages": 68,
            "installer": "uv",
            "pythonVersion": "3.12"
          }
        }
      ],
      "baseImages": {
        "static": {
          "ref": "docker.io/library/debian:bookworm-slim",
          "digest": "sha256:2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f80910",
          "invoke": "/bin/sh",
          "user": "",
          "platforms": [ "linux/amd64", "linux/arm64" ]
        },
        "python": {
          "ref": "docker.io/library/python:3.12-slim-bookworm",
          "digest": "sha256:3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f8091023",
          "invoke": "/bin/sh",
          "user": "",
          "platforms": [ "linux/amd64", "linux/arm64" ]
        }
      },
      "sdks": [
        {
          "provider": "modal",
          "package": "modal",
          "version": "0.10.1",
          "integrity": "sha512-bm5zV29WNFhOTEh0Ym9ndXNpbnRlZ3JpdHlmb3JleGFtcGxlb25seTEyMzQ1Njc4OTA="
        }
      ]
    }
  ],
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "pinnedAt",
    "platforms",
    "tools",
    "baseImages",
    "sdks"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "maxwell.toolchain"
    },
    "pinnedAt": {
      "description": "When the pins were taken from upstream and verified",
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/timestamp"
    },
    "platforms": {
      "description": "Platforms the artifacts cover",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "tools": {
      "description": "Every tool Maxwell may run; a tool needs at least one of artifacts, image or python",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "baseImages": {
      "description": "Pinned base images that run a verified binary or a hash-locked Python install when a tool ships no image of its own",
      "type": "object",
      "required": [ "static", "python" ],
      "properties": {
        "static": {
          "$ref": "#/$defs/image"
        },
        "python": {
          "$ref": "#/$defs/image"
        }
      },
      "additionalProperties": false
    },
    "sdks": {
      "description": "Hosted sandbox SDKs installed on demand outside the workspace, pinned by exact version and npm integrity",
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/sdk"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "platform": {
      "description": "Operating system and CPU architecture of a release artifact",
      "enum": [ "linux-amd64", "linux-arm64", "darwin-arm64" ]
    },
    "sha256": {
      "description": "Lower-case hex SHA-256 digest",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "description": "Exact upstream version, never a range or a floating tag",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?([.-][0-9A-Za-z.-]+)?$"
    },
    "tool": {
      "description": "One pinned tool",
      "type": "object",
      "anyOf": [
        {
          "required": [ "artifacts" ]
        },
        {
          "required": [ "image" ]
        },
        {
          "required": [ "python" ]
        }
      ],
      "required": [ "name", "category", "version", "source", "versionCheck" ],
      "properties": {
        "name": {
          "description": "Tool name, as agents pass it to scan.mjs or exec.mjs",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "category": {
          "description": "scanner runs over repository checkouts; runtime-cli runs read-only probe commands; helper supports both",
          "enum": [ "scanner", "runtime-cli", "helper" ]
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "source": {
          "description": "Release page or package page the pin was taken from",
          "type": "string",
          "pattern": "^https://"
        },
        "versionCheck": {
          "description": "Arguments that print the version, and the text the output must contain before any result is trusted",
          "type": "object",
          "required": [ "args", "expect" ],
          "properties": {
            "args": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z-]+$"
              }
            },
            "expect": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "description": "Release artifacts by platform",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/platform"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "python": {
          "$ref": "#/$defs/python"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "description": "A release artifact; the sha256 is checked before the file is unpacked or run",
      "type": "object",
      "if": {
        "properties": {
          "archive": {
            "const": "tar.gz"
          }
        }
      },
      "then": {
        "required": [ "binaryPath" ]
      },
      "required": [ "url", "sha256", "sha256Source", "archive" ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sha256Source": {
          "description": "upstream-checksums-verified: from the project's checksum file and re-computed from the download at pin time; upstream-checksums or upstream-sidecar: from the project's checksum file or .sha256 sidecar; computed-at-pin: the project publishes no checksum, so the digest of the downloaded artifact was recorded",
          "enum": [
            "upstream-checksums-verified",
            "upstream-checksums",
            "upstream-sidecar",
            "computed-at-pin"
          ]
        },
        "archive": {
          "enum": [ "tar.gz", "none" ]
        },
        "binaryPath": {
          "description": "Path of the executable inside the archive",
          "type": "string",
          "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$"
        },
        "verifiedVersionOutput": {
          "description": "First line the binary printed for versionCheck at pin time",
          "type": "string",
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "image": {
      "description": "An OCI image pinned by digest; the tag is informational and the digest is what runs",
      "type": "object",
      "required": [ "ref", "digest", "invoke" ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+:[A-Za-z0-9._-]+$"
        },
        "digest": {
          "description": "Manifest (or index) digest",
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "invoke": {
          "description": "Executable to run inside the image, bypassing wrapper entrypoints",
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "user": {
          "description": "User the image declares, empty when it declares none",
          "type": "string",
          "maxLength": 64
        },
        "platforms": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+/[a-z0-9]+(/v[0-9]+)?$"
          }
        }
      },
      "additionalProperties": false
    },
    "python": {
      "description": "A Python tool installed with the pinned uv from a hash-locked requirements file; every package and file hash is checked",
      "type": "object",
      "required": [
        "package",
        "lock",
        "lockSha256",
        "installer",
        "pythonVersion"
      ],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "lock": {
          "description": "Requirements file relative to the references directory",
          "type": "string",
          "pattern": "^locks/[a-z0-9-]+\\.txt$"
        },
        "lockSha256": {
          "$ref": "#/$defs/sha256"
        },
        "packages": {
          "type": "integer",
          "minimum": 1
        },
        "installer": {
          "const": "uv"
        },
        "pythonVersion": {
          "type": "string",
          "pattern": "^3\\.[0-9]{1,2}$"
        }
      },
      "additionalProperties": false
    },
    "sdk": {
      "description": "A hosted sandbox SDK",
      "type": "object",
      "required": [ "provider", "package", "version", "integrity" ],
      "properties": {
        "provider": {
          "enum": [ "e2b", "daytona", "modal", "vercel" ]
        },
        "package": {
          "type": "string",
          "pattern": "^(@[a-z0-9-]+/)?[a-z0-9.-]+$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "integrity": {
          "description": "npm dist.integrity of the pinned version",
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "additionalProperties": false
    }
  }
}
