{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxwell.onfinance.ai/schemas/vocab/pricing.schema.json",
  "title": "Model pricing table (USD per million tokens)",
  "description": "Versioned list price table used by the cost_of_audit KPI. Cache write has separate 5-minute and 1-hour buckets because Anthropic bills them differently. Prices are list prices from platform.claude.com on the stated date; verify before changing",
  "examples": [
    {
      "schemaVersion": "1",
      "kind": "maxwell.vocab.pricing",
      "asOf": "2026-09-13",
      "source": "https://platform.claude.com/docs/en/about-claude/pricing",
      "models": [
        {
          "model": "claude-opus-5",
          "aliases": [ "opus" ],
          "provider": "anthropic",
          "inputPerMTok": 5,
          "outputPerMTok": 25,
          "cacheWrite5mPerMTok": 6.25,
          "cacheWrite1hPerMTok": 10,
          "cacheReadPerMTok": 0.5
        }
      ]
    }
  ],
  "type": "object",
  "required": [ "schemaVersion", "kind", "asOf", "source", "models" ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "maxwell.vocab.pricing"
    },
    "asOf": {
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/date"
    },
    "source": {
      "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/url"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model",
          "aliases",
          "inputPerMTok",
          "outputPerMTok",
          "cacheWrite5mPerMTok",
          "cacheWrite1hPerMTok",
          "cacheReadPerMTok"
        ],
        "properties": {
          "model": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/modelId"
            }
          },
          "provider": {
            "description": "Provider the price applies to (common genAiProvider, the same value session/summary models[].provider carries so the cost join cannot miss); omit for anthropic list prices",
            "$ref": "https://maxwell.onfinance.ai/schemas/v1/common.schema.json#/$defs/genAiProvider"
          },
          "inputPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "outputPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "cacheWrite5mPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "cacheWrite1hPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "cacheReadPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "webSearchPerKRequests": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
