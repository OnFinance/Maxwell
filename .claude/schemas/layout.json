{
  "schemaVersion": "1",
  "kind": "maxwell.layout",
  "description": "The sanctioned workspace layout. validate-layout.mjs rejects any file or directory not matched by a rule; validate-data.mjs validates each matched file against its schema. Globs are POSIX, anchored at the workspace root, and use '*' for one path segment.",
  "rootEntries": [
    "CLAUDE.md",
    "AGENTS.md",
    "LICENSE",
    ".gitignore",
    ".editorconfig",
    "package.json",
    "package-lock.json",
    "opencode.json",
    ".github",
    ".claude",
    ".agents",
    "company-profile",
    "applications",
    "kpis",
    "cves",
    "node_modules",
    ".git"
  ],
  "harnessDirs": {
    ".claude": [
      "scripts",
      "schemas",
      "commands",
      "agents",
      "workflows",
      "skills",
      "hooks",
      "settings.json"
    ],
    ".agents": [
      "scripts",
      "schemas",
      "commands",
      "agents",
      "workflows",
      "skills",
      "hooks"
    ]
  },
  "rules": [
    {
      "glob": "LICENSE",
      "format": "any"
    },
    {
      "glob": ".gitignore",
      "format": "any"
    },
    {
      "glob": ".editorconfig",
      "format": "any"
    },
    {
      "glob": "package.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/meta/package.schema.json"
    },
    {
      "glob": "package-lock.json",
      "format": "any"
    },
    {
      "glob": ".claude/schemas/tests/**/*.test.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/meta/schema-test.schema.json"
    },
    {
      "glob": ".claude/skills/kpi-extraction/references/pricing.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/vocab/pricing.schema.json"
    },
    {
      "glob": ".claude/skills/regulatory-catalogs/references/sla-table.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/vocab/sla-table.schema.json"
    },
    {
      "glob": ".github/workflows/*.yml",
      "format": "yaml"
    },
    {
      "glob": "CLAUDE.md",
      "format": "markdown"
    },
    {
      "glob": "AGENTS.md",
      "format": "markdown"
    },
    {
      "glob": "opencode.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/harness/opencode-config.schema.json"
    },
    {
      "glob": ".claude/settings.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/harness/claude-settings.schema.json"
    },
    {
      "glob": ".claude/schemas/layout.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/meta/layout.schema.json"
    },
    {
      "glob": ".claude/schemas/**/*.schema.json",
      "format": "json-schema"
    },
    {
      "glob": ".claude/scripts/**/*.mjs",
      "format": "javascript"
    },
    {
      "glob": ".claude/scripts/**/*.json",
      "format": "any"
    },
    {
      "glob": ".claude/commands/*.md",
      "format": "frontmatter",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/claude-command.schema.json"
    },
    {
      "glob": ".claude/agents/*.md",
      "format": "frontmatter",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/claude-agent.schema.json"
    },
    {
      "glob": ".claude/workflows/*.js",
      "format": "workflow"
    },
    {
      "glob": ".claude/skills/*/SKILL.md",
      "format": "frontmatter",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/skill.schema.json"
    },
    {
      "glob": ".claude/skills/*/references/**",
      "format": "any"
    },
    {
      "glob": ".claude/skills/*/scripts/**",
      "format": "any"
    },
    {
      "glob": ".claude/skills/*/assets/**",
      "format": "any"
    },
    {
      "glob": ".claude/skills/regulatory-catalogs/references/instruments.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/catalog/instruments.schema.json"
    },
    {
      "glob": ".claude/skills/regulatory-catalogs/references/catalogs/*.catalog.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/catalog/regulator-catalog.schema.json"
    },
    {
      "glob": ".claude/hooks/*.mjs",
      "format": "javascript"
    },
    {
      "glob": ".claude/hooks/git/*",
      "format": "any"
    },
    {
      "glob": ".agents/scripts",
      "format": "symlink",
      "target": "../.claude/scripts"
    },
    {
      "glob": ".agents/schemas",
      "format": "symlink",
      "target": "../.claude/schemas"
    },
    {
      "glob": ".agents/commands/*.md",
      "format": "frontmatter",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/opencode-command.schema.json"
    },
    {
      "glob": ".agents/agents/*.md",
      "format": "frontmatter",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/opencode-agent.schema.json"
    },
    {
      "glob": ".agents/workflows/*.js",
      "format": "workflow"
    },
    {
      "glob": ".agents/skills/*/SKILL.md",
      "format": "frontmatter",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/skill.schema.json"
    },
    {
      "glob": ".agents/skills/*/references/**",
      "format": "any"
    },
    {
      "glob": ".agents/hooks/*.mjs",
      "format": "javascript"
    },
    {
      "glob": "company-profile/*/details.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/company/details.schema.json"
    },
    {
      "glob": "company-profile/*/summary.md",
      "format": "frontmatter",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/company-summary.schema.json"
    },
    {
      "glob": "company-profile/*/sdlc/policy.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/company/sdlc-policy.schema.json"
    },
    {
      "glob": "company-profile/*/sdlc/metastore.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/company/metastore.schema.json"
    },
    {
      "glob": "company-profile/*/vendors/*.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/company/vendor.schema.json"
    },
    {
      "glob": "company-profile/*/soc/main.jsonl",
      "format": "jsonl",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/soc/record.schema.json"
    },
    {
      "glob": "company-profile/*/soc/versions/commit_*.diff",
      "format": "diff"
    },
    {
      "glob": "company-profile/*/change_management/master.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/change-management/master.schema.json"
    },
    {
      "glob": "company-profile/*/change_management/initiatives/*/timeline.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/change-management/timeline.schema.json"
    },
    {
      "glob": "company-profile/*/change_management/initiatives/*/tasks/task_*.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/change-management/task.schema.json"
    },
    {
      "glob": "company-profile/*/suggestions/master.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/suggestions/master.schema.json"
    },
    {
      "glob": "company-profile/*/suggestions/suggestions/*/*/*.diff",
      "format": "diff"
    },
    {
      "glob": "applications/*/README.md",
      "format": "markdown"
    },
    {
      "glob": "applications/*/env/*.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/application/environment.schema.json"
    },
    {
      "glob": "applications/*/repos/*.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/application/repo.schema.json"
    },
    {
      "glob": "applications/*/images/*.cdx.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/application/sbom-ref.schema.json"
    },
    {
      "glob": "applications/*/images/*.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/application/image.schema.json",
      "exclude": [
        "*.cdx.json"
      ]
    },
    {
      "glob": "applications/*/credentials.json",
      "format": "sops-json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/application/credentials.schema.json"
    },
    {
      "glob": "kpis/metrics.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/kpi/registry.schema.json"
    },
    {
      "glob": "kpis/measurement/*.md",
      "format": "frontmatter",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/frontmatter/kpi-methodology.schema.json"
    },
    {
      "glob": "kpis/measurement/runs.jsonl",
      "format": "jsonl",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/kpi/run.schema.json"
    },
    {
      "glob": "kpis/data/raw/sessions/*/*.jsonl",
      "format": "any"
    },
    {
      "glob": "kpis/data/raw/sessions/*/*.export.json",
      "format": "any"
    },
    {
      "glob": "kpis/data/raw/sessions/*/*.meta.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/session/meta.schema.json"
    },
    {
      "glob": "kpis/data/raw/sessions/*/*.summary.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/session/summary.schema.json"
    },
    {
      "glob": "kpis/data/raw/pagerduty/*.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/kpi/pagerduty-export.schema.json"
    },
    {
      "glob": "kpis/data/*/series.jsonl",
      "format": "jsonl",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/kpi/datapoint.schema.json",
      "exclude": [
        "kpis/data/raw/**"
      ]
    },
    {
      "glob": "cves/search/*.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/cve/search.schema.json"
    },
    {
      "glob": "cves/data/*.json",
      "format": "json",
      "schema": "https://maxwell.onfinance.ai/schemas/v1/cve/record.schema.json"
    },
    {
      "glob": "**/.gitkeep",
      "format": "empty"
    }
  ],
  "requiredPerCompany": [
    "details.json",
    "summary.md",
    "sdlc/policy.json",
    "soc/main.jsonl",
    "change_management/master.json",
    "suggestions/master.json"
  ],
  "requiredPerApplication": [
    "README.md",
    "credentials.json"
  ],
  "requiredFiles": [
    "kpis/metrics.json",
    "CLAUDE.md",
    "AGENTS.md",
    ".claude/settings.json",
    "opencode.json"
  ]
}
