{
  "description": "Read-only command allow-list enforced by .claude/scripts/lib/sandbox/command-policy.mjs for every runtime probe command run through sandbox/exec.mjs. Entries are argv prefixes; a token ending in * matches any token with that prefix and a lone * matches any token. Put flags after the command words. The rules of engagement (SKILL.md section 2) stay authoritative: secret-returning verbs, write verbs, credential and endpoint flags, prod logs and secrets are refused in code even if an entry here matched.",
  "families": {
    "kubectl": {
      "method": "kubeconfig",
      "allow": [
        { "argv": ["kubectl", "get"] },
        { "argv": ["kubectl", "describe"] },
        { "argv": ["kubectl", "logs"], "tiers": ["dev", "test", "devtest", "qa", "uat", "staging", "sandbox"] },
        { "argv": ["kubectl", "top"] },
        { "argv": ["kubectl", "auth", "can-i"] },
        { "argv": ["kubectl", "version"] },
        { "argv": ["kubectl", "api-resources"] },
        { "argv": ["kubectl", "cluster-info"] }
      ]
    },
    "docker": {
      "method": "docker-socket",
      "allow": [
        { "argv": ["docker", "version"] },
        { "argv": ["docker", "info"] },
        { "argv": ["docker", "ps"] },
        { "argv": ["docker", "images"] },
        { "argv": ["docker", "inspect"] },
        { "argv": ["docker", "network", "ls"] },
        { "argv": ["docker", "network", "inspect"] },
        { "argv": ["docker", "volume", "ls"] },
        { "argv": ["docker", "volume", "inspect"] }
      ]
    },
    "aws": {
      "method": "cloud-api",
      "allow": [
        { "argv": ["aws", "sts", "get-caller-identity"] },
        { "argv": ["aws", "accessanalyzer", "list-*"] },
        { "argv": ["aws", "acm", "describe-certificate"] },
        { "argv": ["aws", "acm", "list-certificates"] },
        { "argv": ["aws", "apigateway", "get-rest-apis"] },
        { "argv": ["aws", "apigatewayv2", "get-apis"] },
        { "argv": ["aws", "autoscaling", "describe-auto-scaling-groups"] },
        { "argv": ["aws", "backup", "describe-backup-vault"] },
        { "argv": ["aws", "backup", "get-backup-plan"] },
        { "argv": ["aws", "backup", "list-*"] },
        { "argv": ["aws", "bedrock", "get-model-invocation-logging-configuration"] },
        { "argv": ["aws", "bedrock", "list-foundation-models"] },
        { "argv": ["aws", "cloudfront", "get-distribution-config"] },
        { "argv": ["aws", "cloudfront", "list-distributions"] },
        { "argv": ["aws", "cloudtrail", "describe-trails"] },
        { "argv": ["aws", "cloudtrail", "get-trail-status"] },
        { "argv": ["aws", "cloudtrail", "lookup-events"] },
        { "argv": ["aws", "cloudwatch", "describe-alarms"] },
        { "argv": ["aws", "ec2", "describe-*"] },
        { "argv": ["aws", "ecr", "describe-image-scan-findings"] },
        { "argv": ["aws", "ecr", "describe-images"] },
        { "argv": ["aws", "ecr", "describe-repositories"] },
        { "argv": ["aws", "ecs", "describe-*"] },
        { "argv": ["aws", "ecs", "list-*"] },
        { "argv": ["aws", "eks", "describe-access-entry"] },
        { "argv": ["aws", "eks", "describe-cluster"] },
        { "argv": ["aws", "eks", "describe-nodegroup"] },
        { "argv": ["aws", "eks", "list-access-entries"] },
        { "argv": ["aws", "eks", "list-associated-access-policies"] },
        { "argv": ["aws", "eks", "list-clusters"] },
        { "argv": ["aws", "eks", "list-nodegroups"] },
        { "argv": ["aws", "elbv2", "describe-*"] },
        { "argv": ["aws", "events", "describe-rule"] },
        { "argv": ["aws", "events", "list-rules"] },
        { "argv": ["aws", "iam", "get-*"] },
        { "argv": ["aws", "iam", "list-*"] },
        { "argv": ["aws", "iam", "simulate-principal-policy"] },
        { "argv": ["aws", "identitystore", "list-*"] },
        { "argv": ["aws", "kms", "describe-key"] },
        { "argv": ["aws", "kms", "get-key-policy"] },
        { "argv": ["aws", "kms", "get-key-rotation-status"] },
        { "argv": ["aws", "kms", "list-aliases"] },
        { "argv": ["aws", "kms", "list-keys"] },
        { "argv": ["aws", "lambda", "get-function-configuration"] },
        { "argv": ["aws", "lambda", "list-functions"] },
        { "argv": ["aws", "logs", "describe-log-groups"] },
        { "argv": ["aws", "logs", "describe-log-streams"] },
        { "argv": ["aws", "macie2", "get-finding-statistics"] },
        { "argv": ["aws", "macie2", "list-findings"] },
        { "argv": ["aws", "network-firewall", "describe-*"] },
        { "argv": ["aws", "network-firewall", "list-*"] },
        { "argv": ["aws", "organizations", "describe-organization"] },
        { "argv": ["aws", "organizations", "describe-policy"] },
