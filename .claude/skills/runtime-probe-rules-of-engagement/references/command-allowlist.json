        { "argv": ["aws", "route53", "list-*"] },
        { "argv": ["aws", "s3api", "get-bucket-*"] },
        { "argv": ["aws", "s3api", "get-object-lock-configuration"] },
        { "argv": ["aws", "s3api", "get-public-access-block"] },
        { "argv": ["aws", "s3api", "list-buckets"] },
        { "argv": ["aws", "secretsmanager", "describe-secret"] },
        { "argv": ["aws", "secretsmanager", "get-resource-policy"] },
        { "argv": ["aws", "secretsmanager", "list-secrets"] },
        { "argv": ["aws", "shield", "describe-subscription"] },
        { "argv": ["aws", "sqs", "get-queue-attributes"] },
        { "argv": ["aws", "sqs", "list-dead-letter-source-queues"] },
        { "argv": ["aws", "sqs", "list-queues"] },
        { "argv": ["aws", "ssm", "describe-parameters"] },
        { "argv": ["aws", "ssm", "describe-sessions"] },
        { "argv": ["aws", "ssm", "get-document"] },
        { "argv": ["aws", "sso-admin", "describe-permission-set"] },
        { "argv": ["aws", "sso-admin", "list-*"] },
        { "argv": ["aws", "wafv2", "get-logging-configuration"] },
        { "argv": ["aws", "wafv2", "get-web-acl"] },
        { "argv": ["aws", "wafv2", "get-web-acl-for-resource"] },
        { "argv": ["aws", "wafv2", "list-*"] }
      ]
    },
    "gcloud": {
      "method": "cloud-api",
      "allow": [
        { "argv": ["gcloud", "projects", "describe"] },
        { "argv": ["gcloud", "projects", "get-iam-policy"] },
        { "argv": ["gcloud", "artifacts", "docker", "images", "describe"] },
        { "argv": ["gcloud", "compute", "*", "describe"] },
        { "argv": ["gcloud", "compute", "*", "list"] },
        { "argv": ["gcloud", "container", "clusters", "describe"] },
        { "argv": ["gcloud", "container", "clusters", "list"] },
        { "argv": ["gcloud", "container", "node-pools", "describe"] },
        { "argv": ["gcloud", "dns", "record-sets", "list"] },
        { "argv": ["gcloud", "iam", "roles", "describe"] },
        { "argv": ["gcloud", "iam", "service-accounts", "list"] },
        { "argv": ["gcloud", "iam", "service-accounts", "keys", "list"] },
        { "argv": ["gcloud", "kms", "keys", "describe"] },
        { "argv": ["gcloud", "kms", "keys", "list"] },
        { "argv": ["gcloud", "logging", "buckets", "list"] },
        { "argv": ["gcloud", "pubsub", "subscriptions", "describe"] },
        { "argv": ["gcloud", "pubsub", "topics", "describe"] },
        { "argv": ["gcloud", "secrets", "describe"] },
        { "argv": ["gcloud", "secrets", "list"] },
        { "argv": ["gcloud", "sql", "backups", "list"] },
        { "argv": ["gcloud", "sql", "instances", "describe"] },
        { "argv": ["gcloud", "storage", "buckets", "describe"] }
      ]
    },
    "az": {
      "method": "cloud-api",
      "allow": [
        { "argv": ["az", "account", "show"] },
        { "argv": ["az", "acr", "repository", "show"] },
        { "argv": ["az", "ad", "app", "credential", "list"] },
        { "argv": ["az", "ad", "sp", "list"] },
        { "argv": ["az", "ad", "user", "list"] },
        { "argv": ["az", "aks", "list"] },
        { "argv": ["az", "aks", "show"] },
        { "argv": ["az", "backup", "vault", "show"] },
        { "argv": ["az", "keyvault", "list"] },
        { "argv": ["az", "keyvault", "secret", "list"] },
        { "argv": ["az", "keyvault", "show"] },
        { "argv": ["az", "monitor", "activity-log", "list"] },
        { "argv": ["az", "monitor", "log-analytics", "workspace", "show"] },
        { "argv": ["az", "network", "*", "list"] },
        { "argv": ["az", "network", "*", "show"] },
        { "argv": ["az", "network", "*", "*", "list"] },
        { "argv": ["az", "postgres", "flexible-server", "show"] },
        { "argv": ["az", "role", "assignment", "list"] },
        { "argv": ["az", "role", "definition", "list"] },
        { "argv": ["az", "servicebus", "queue", "show"] },
        { "argv": ["az", "storage", "account", "list"] },
        { "argv": ["az", "storage", "account", "show"] },
        { "argv": ["az", "vm", "show"] }
      ]
    },
    "crane": {
      "method": "cloud-api",
      "allow": [
        { "argv": ["crane", "digest"] }
      ]
    },
    "cosign": {
      "method": "cloud-api",
      "allow": [
        { "argv": ["cosign", "tree"] },
        { "argv": ["cosign", "verify"] },
        { "argv": ["cosign", "verify-attestation"] }
      ]
    },
    "curl": { "method": "http-only" },
    "openssl": { "method": "http-only" },
    "ssh": { "method": "ssh" }
  },
  "ssh": {
    "remoteCommands": [
      "uname -a",
      "cat /etc/os-release",
      "systemctl list-units --type=service --no-pager",
      "ss -tulpn",
      "ps -eo pid,user,cmd --no-headers",
      "df -h",
      "mount",
      "iptables -S",
      "nft list ruleset",
      "cat /etc/ssh/sshd_config",
      "ls -la /[A-Za-z0-9._/-]*",
      "stat /[A-Za-z0-9._/-]*",
      "sha256sum /[A-Za-z0-9._/-]*",
      "journalctl --no-pager -n [0-9]{1,5} -u [A-Za-z0-9@._-]+"
    ]
  },
  "pipeStages": [
    { "argv": ["jq"] },
    { "argv": ["grep"] },
    { "argv": ["head", "-c"] }
  ]
}
