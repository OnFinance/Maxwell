{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MaxwellAssumesWithExternalId",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::<MAXWELL_ACCOUNT_ID>:root" },
      "Action": "sts:AssumeRole",
      "Condition": { "StringEquals": { "sts:ExternalId": "<EXTERNAL_ID_FROM_THE_CREDENTIALS_PAGE>" } }
    }
  ]
}
