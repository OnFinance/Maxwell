{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocalMaxwellAssumesWithExternalId",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::<YOUR_ASSUMING_ACCOUNT_ID>:root" },
      "Action": "sts:AssumeRole",
      "Condition": { "StringEquals": { "sts:ExternalId": "<YOUR_EXTERNAL_ID>" } }
    }
  ]
}
