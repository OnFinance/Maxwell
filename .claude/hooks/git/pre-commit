#!/usr/bin/env bash
# Maxwell git pre-commit: validate staged workspace files (fast path) and refuse plaintext secrets.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#staged[@]}" -eq 0 ] && exit 0

if printf '%s\n' "${staged[@]}" | grep -qE '\.schema\.json$'; then
  npm run --silent validate:schemas
fi
data=()
for f in "${staged[@]}"; do
  case "$f" in
    *.json|*.jsonl|*.md|*.diff) data+=("$f");;
  esac
done
if [ "${#data[@]}" -gt 0 ]; then
  node .claude/scripts/validate-data.mjs "${data[@]}"
fi
node .claude/scripts/validate-layout.mjs
node .claude/scripts/validate-mirror.mjs
